# Local: copy to .env.local
#   NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: set the same keys in Vercel (or .env.production on a VPS).

NEXT_PUBLIC_SITE_URL=https://accordmedical.co.ke

# ERP catalog (legacy remote API — used only if CATALOG_SOURCE=remote, or before the first MySQL copy)
ERP_API_BASE_URL=https://backend.codewithseth.co.ke
ERP_ORG_ID=
# Optional. Defaults: 4000ms in development, 8000ms in production.
# ERP_TIMEOUT_MS=4000

# After copying products into MySQL, the site reads from the local catalog automatically.
# auto = MySQL when rows exist, otherwise the old shop API
# mysql = always local MySQL
# remote = always the old shop API
CATALOG_SOURCE=auto
# CATALOG_SOURCE_URL=https://accordmedical.co.ke/api/get_spdk_items.php
# Optional header x-import-key for /api/admin/catalog-import (defaults to ADMIN_SESSION_SECRET)
# CATALOG_IMPORT_KEY=

# MongoDB Atlas (optional if MySQL is configured)
MONGODB_URI=
MONGODB_DB_NAME=tarumed

# MySQL / phpMyAdmin (accordm_accord)
MYSQL_HOST=accordmedical.co.ke
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=accordm_accord

# Cloudinary (optional if MySQL stores images and catalogues)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Admin (created on first login if no admins exist)
ADMIN_USERNAME=accordm_makori
ADMIN_EMAIL=info@accordmedical.co.ke
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
