# Local Next.js: copy secrets to .env.local (see MySQL/admin below).
# Local API URL is in .env.development (http://localhost:4000).

# Vercel / production Next.js — this is the only value to set:
ACCORD_API_URL=https://accord.codewithseth.co.ke

# Backend VPS: set the same ACCORD_API_URL in the host panel.
# Keep MySQL and admin secrets in .env.local on the server (not in the panel).

NEXT_PUBLIC_SITE_URL=https://accordmedical.co.ke

# The live site reads products from MySQL only. Do not set this to remote.
CATALOG_SOURCE=mysql

# ERP quotes (not the product catalog)
ERP_API_BASE_URL=https://backend.codewithseth.co.ke
ERP_ORG_ID=

# MongoDB Atlas (optional if MySQL is configured)
MONGODB_URI=
MONGODB_DB_NAME=tarumed

# MySQL / phpMyAdmin (accordm_accord) — backend server file, not Vercel
MYSQL_HOST=accordmedical.co.ke
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=accordm_accord

# Cloudinary (optional if MySQL stores images and catalogues)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Admin (created on first login if no admins exist)
ADMIN_USERNAME=accordm_makori
ADMIN_EMAIL=info@accordmedical.co.ke
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
